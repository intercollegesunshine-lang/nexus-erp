// prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql" // Updated for your Neon Cloud Database!
  url      = env("DATABASE_URL")
}

// 1. Core User Model for Authentication
model User {
  id            String    @id @default(cuid())
  email         String    @unique
  passwordHash  String
  
  role          String    @default("STUDENT") 
  
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  studentProfile StudentProfile?
}

// 2. NEW: Class Model (Handles Timetables and Grouping)
model Class {
  id            String          @id @default(cuid())
  name          String          @unique // e.g., "10-A", "11-Science"
  timetableUrl  String?         // URL to the uploaded timetable image/PDF
  
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  
  // A Class has many Students
  students      StudentProfile[]
}

// 3. Student Specific Data
model StudentProfile {
  id            String    @id @default(cuid())
  
  // Foreign Keys
  userId        String    @unique
  classId       String?   // NEW: Optional link to a Class
  
  // Relations
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  class         Class?    @relation(fields: [classId], references: [id], onDelete: SetNull)
  
  enrollmentNo  String    @unique
  firstName     String
  lastName      String
  dateOfBirth   DateTime
  bloodGroup    String?
  gradeLevel    String    // e.g., "10th"
  section       String    // e.g., "A"
  
  fees          FeeInvoice[]
  results       ExamResult[]
  attendance    Attendance[]

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

// 4. Fee Management System
model FeeInvoice {
  id            String        @id @default(cuid())
  studentId     String
  student       StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)
  
  title         String        // e.g., "Tuition Fee - Q1"
  amount        Float
  dueDate       DateTime
  
  status        String        @default("PENDING") 
  
  payments      Payment[]
  createdAt     DateTime      @default(now())
}

model Payment {
  id            String     @id @default(cuid())
  invoiceId     String
  invoice       FeeInvoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  
  amountPaid    Float
  paymentDate   DateTime   @default(now())
  transactionId String?    @unique
  paymentMethod String     // e.g., "STRIPE", "RAZORPAY", "UPI"
}

// 5. Result & Academic Management
model ExamResult {
  id            String         @id @default(cuid())
  studentId     String
  student       StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)
  
  examName      String         // e.g., "Mid-Term 2026"
  subject       String
  marksObtained Float
  totalMarks    Float
  grade         String
  remarks       String?
  
  createdAt     DateTime       @default(now())
}

// 6. Attendance Tracking
model Attendance {
  id            String         @id @default(cuid())
  studentId     String
  student       StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)
  
  date          DateTime
  status        String         // "PRESENT", "ABSENT", "LATE", "HALF_DAY"
  
  @@unique([studentId, date])
}
// STREAMING_CHUNK:Configuring database generator and datasource...
generator client {
provider = "prisma-client-js"
}

datasource db {
provider = "postgresql"
url      = env("DATABASE_URL")
}

// STREAMING_CHUNK:Defining core User and Student models...
model User {
id             String          @id @default(cuid())
email          String          @unique
passwordHash   String
role           String          @default("STUDENT")
createdAt      DateTime        @default(now())
updatedAt      DateTime        @default(now()) @updatedAt
studentProfile StudentProfile?
}

model StudentProfile {
id           String       @id @default(cuid())
userId       String       @unique
user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

enrollmentNo String       @unique
firstName    String
lastName     String
dateOfBirth  DateTime
bloodGroup   String?
gradeLevel   String
section      String

classId      String?
class        Class?       @relation(fields: [classId], references: [id])

fees         FeeInvoice[]
results      ExamResult[]
attendances  Attendance[]
submissions  Submission[] // NEW: Links to assignments the student submitted!

createdAt    DateTime     @default(now())
updatedAt    DateTime     @default(now()) @updatedAt
}

// STREAMING_CHUNK:Defining Class and Schedule models...
model Class {
id           String    @id @default(cuid())
name         String    @unique
timetableUrl String?

students     StudentProfile[]
schedules    Schedule[]
assignments  Assignment[] // NEW: Assignments belong to a specific class
}

model Schedule {
id        String   @id @default(cuid())
classId   String
class     Class    @relation(fields: [classId], references: [id], onDelete: Cascade)

dayOfWeek String

subject   String
startTime String

endTime   String

room      String?
}

// STREAMING_CHUNK:Defining Financial and Academic models...
model FeeInvoice {
id          String   @id @default(cuid())
studentId   String
student     StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)

title       String
amount      Float
dueDate     DateTime
status      String   @default("PENDING")

createdAt   DateTime @default(now())
updatedAt   DateTime @default(now()) @updatedAt
}

model Payment {
id            String   @id @default(cuid())
invoiceId     String   @unique
amountPaid    Float
paymentMethod String
transactionId String   @unique
date          DateTime @default(now())
}

model ExamResult {
id            String   @id @default(cuid())
studentId     String
student       StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)

examName      String
subject       String
marksObtained Float
totalMarks    Float
grade         String
remarks       String?

createdAt     DateTime @default(now())
}

model Attendance {
id          String   @id @default(cuid())
studentId   String
student     StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)

date        DateTime
subject     String   @default("Overall")
status      String

remarks     String?

createdAt   DateTime @default(now())

@@unique([studentId, date, subject])
}

// STREAMING_CHUNK:Defining new Assignment and Submission models...
model Assignment {
id          String       @id @default(cuid())
title       String
description String
subject     String
dueDate     DateTime

classId     String
class       Class        @relation(fields: [classId], references: [id], onDelete: Cascade)

submissions Submission[]

createdAt   DateTime     @default(now())
}

model Submission {
id           String         @id @default(cuid())
studentId    String
student      StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)

assignmentId String
assignment   Assignment     @relation(fields: [assignmentId], references: [id], onDelete: Cascade)

fileUrl      String         // The UploadThing URL
status       String         @default("SUBMITTED") // SUBMITTED or GRADED
grade        String?        // e.g., "95/100" or "A"

submittedAt  DateTime       @default(now())

@@unique([studentId, assignmentId]) // Prevents a student from submitting the same assignment twice
}